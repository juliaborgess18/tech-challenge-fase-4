# Copie para .env e preencha. O .env NÃO deve ser versionado.

# ---------- LLM (geração) ----------
# Chave do provedor de LLM. Enquanto vazia, o pipeline roda em modo "somente recuperação".
LLM_API_KEY=
# Identificador do modelo no provedor escolhido (ex.: gemini-3.5-flash-lite)
LLM_MODEL=gemini-3.5-flash-lite
LLM_MAX_TOKENS=4000
# Raciocínio do Gemini antes de responder: 0 = desligado (mais rápido), -1 = dinâmico (mais lento)
LLM_THINKING_BUDGET=-1

# ---------- Embeddings (local) ----------
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_BATCH_SIZE=64

# ---------- Recuperação ----------
TOP_K_CANDIDATES=60
TOP_K_CONTEXT=15
USE_BM25=true
USE_RERANKER=false
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# ---------- Guardrails (ver docs/decisoes_tecnicas.md, seção de calibração) ----------
# Similaridade mínima (cosseno) para uma avaliação entrar no contexto como evidência
MIN_RELEVANCE=0.85
# Número mínimo de evidências para gerar uma resposta
MIN_EVIDENCES=3
# Margem do classificador de escopo (similaridade com exemplos no escopo - fora do escopo)
SCOPE_MARGIN=0.0
# Termo-chave presente em menos avaliações que isto = conceito desconhecido na base
MIN_TERM_DF=3
# Fração dos termos-chave que uma avaliação precisa conter para contar como suporte lexical
LEXICAL_COVERAGE=0.6
